@page
@model GenerateRecoveryCodesModel

@{
    ViewData["Title"] = "Generate 2FA Recovery Codes";
}

<div class="container py-5">
    <h3 class="mb-4">
        <i class="fas fa-key text-warning me-2"></i> Generate 2FA Recovery Codes
    </h3>
    <partial name="_StatusMessage" for="StatusMessage" />

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="alert alert-warning d-flex align-items-start">
                <i class="fas fa-shield-alt fa-2x me-3"></i>
                <div>
                    <p class="mb-2"><strong>Store these codes securely.</strong></p>
                    <p class="mb-0">If you lose them, you could lose access to your account.</p>
                </div>
            </div>
            <form method="post" class="text-center">
                <button type="submit" class="btn btn-danger btn-lg">
                    <i class="fas fa-plus-circle me-2"></i> Generate New Codes
                </button>
            </form>
        </div>
    </div>
</div>

