@page
@model ExternalLoginsModel
@{
    ViewData["Title"] = "Manage External Logins";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-primary text-white rounded-top-4">
                    <i class="fas fa-link fa-lg me-2"></i> Manage Linked Accounts
                </div>
                <div class="card-body p-4">
                    <partial name="_StatusMessage" for="StatusMessage" />

                    @if (Model.CurrentLogins?.Count > 0)
                    {
                        <h5 class="mb-3">Linked Accounts</h5>
                        <ul class="list-group mb-4">
                            @foreach (var login in Model.CurrentLogins)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>@login.ProviderDisplayName</span>
                                    @if (Model.ShowRemoveButton)
                                    {
                                        <form asp-page-handler="RemoveLogin" method="post" class="d-inline">
                                            <input type="hidden" name="LoginProvider" value="@login.LoginProvider" />
                                            <input type="hidden" name="ProviderKey" value="@login.ProviderKey" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="fas fa-unlink me-1"></i> Remove
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Required</span>
                                    }
                                </li>
                            }
                        </ul>
                    }

                    @if (Model.OtherLogins?.Count > 0)
                    {
                        <h5 class="mb-3">Link a New Account</h5>
                        <form asp-page-handler="LinkLogin" method="post" class="d-flex flex-wrap gap-2">
                            @foreach (AuthenticationScheme provider in Model.OtherLogins)
                            {
                                <button id="@($"link-login-button-{provider.Name}")"
                                        type="submit"
                                        class="btn btn-outline-dark rounded-pill"
                                        name="provider"
                                        value="@provider.Name">
                                    <i class="fab fa-@provider.Name.ToLower() me-1"></i> @provider.DisplayName
                                </button>
                            }
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
