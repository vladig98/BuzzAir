@{
    Layout = "/Views/Shared/_Layout.cshtml";

    // Determine active page based on request path
    string currentPage = Context.Request.Path;
    string GetActiveClass(string pagePath) => currentPage.EndsWith(pagePath, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold">Account Settings</h1>
        <p class="text-muted">Manage your personal information, security, and preferences</p>
    </div>

    <!-- Navigation Tabs -->
    <ul class="nav nav-pills justify-content-center mb-4" id="settingsTabs" role="tablist">
        <li class="nav-item">
            <a class="nav-link @GetActiveClass("/Manage")" asp-page="./Index">
                <i class="fa-solid fa-user-circle me-2"></i> Profile
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @GetActiveClass("/Email")" asp-page="./Email">
                <i class="fa-solid fa-envelope me-2"></i> Email
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @GetActiveClass("/ChangePassword")" asp-page="./ChangePassword">
                <i class="fa-solid fa-lock me-2"></i> Password
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @GetActiveClass("/TwoFactorAuthentication")" asp-page="./TwoFactorAuthentication">
                <i class="fa-solid fa-shield-halved me-2"></i> Security
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @GetActiveClass("/PersonalData")" asp-page="./PersonalData">
                <i class="fa-solid fa-database me-2"></i> Data
            </a>
        </li>
    </ul>

    <!-- Main Content -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-4">
            @RenderBody()
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
