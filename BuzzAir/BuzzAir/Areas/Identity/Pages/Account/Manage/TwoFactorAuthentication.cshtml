@page
@model TwoFactorAuthenticationModel
@{
    ViewData["Title"] = "Two-Factor Authentication";
}

<div class="container py-5">
    <div class="text-center mb-4">
        <h2 class="fw-bold">@ViewData["Title"]</h2>
        <p class="text-muted">Add an extra layer of protection to your account</p>
    </div>

    <partial name="_StatusMessage" for="StatusMessage" />

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-3 mb-4">
                <div class="card-body p-4">
                    @if (Model.Is2faEnabled)
                    {
                        <div class="alert alert-info">
                            Two-factor authentication is <strong>enabled</strong>.
                            Recovery codes left: <span class="fw-bold">@Model.RecoveryCodesLeft</span>
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            @if (Model.IsMachineRemembered)
                            {
                                <form method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-danger">Forget This Browser</button>
                                </form>
                            }
                            <a asp-page="./Disable2fa" class="btn btn-outline-warning">Disable 2FA</a>
                            <a asp-page="./GenerateRecoveryCodes" class="btn btn-outline-secondary">Reset Codes</a>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            Two-factor authentication is currently <strong>disabled</strong>.
                        </div>
                    }

                    <h5 class="mt-4">Authenticator App</h5>
                    @if (!Model.HasAuthenticator)
                    {
                        <a asp-page="./EnableAuthenticator" class="btn btn-primary mt-2">
                            <i class="fa-solid fa-mobile-screen-button me-2"></i> Add Authenticator App
                        </a>
                    }
                    else
                    {
                        <div class="d-flex gap-2 mt-2">
                            <a asp-page="./EnableAuthenticator" class="btn btn-primary">Set Up App</a>
                            <a asp-page="./ResetAuthenticator" class="btn btn-secondary">Reset App</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
