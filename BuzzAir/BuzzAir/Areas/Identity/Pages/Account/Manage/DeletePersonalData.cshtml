@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Delete Personal Data";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-danger text-white rounded-top-4">
                    <i class="fas fa-user-slash me-2"></i> Delete Personal Data
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-danger mb-4" role="alert">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>This action is permanent!</strong>
                        Deleting your account cannot be undone.
                    </div>

                    <form id="delete-user" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        @if (Model.RequirePassword)
                        {
                            <div class="form-floating mb-3">
                                <input asp-for="Input.Password"
                                       type="password"
                                       class="form-control"
                                       autocomplete="current-password"
                                       placeholder="Enter your password" />
                                <label asp-for="Input.Password">Password</label>
                                <span asp-validation-for="Input.Password" class="text-danger small"></span>
                            </div>
                        }

                        <div class="d-grid">
                            <button type="submit" class="btn btn-danger btn-lg rounded-pill">
                                <i class="fas fa-trash-alt me-1"></i> Delete My Account
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
