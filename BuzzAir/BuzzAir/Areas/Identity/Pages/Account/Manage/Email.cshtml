@page
@model EmailModel
@{
    ViewData["Title"] = "Email";
}

<div class="container py-5">
    <div class="text-center mb-4">
        <h2 class="fw-bold">@ViewData["Title"]</h2>
        <p class="text-muted">View or update your account email</p>
    </div>

    <partial name="_StatusMessage" for="StatusMessage" />

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-4">
                    <form id="email-form" method="post" novalidate>
                        <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                        @if (Model.IsEmailConfirmed)
                        {
                            <div class="input-group mb-4">
                                <input asp-for="Email" class="form-control" disabled />
                                <span class="input-group-text text-success"><i class="fa-solid fa-check"></i></span>
                            </div>
                        }
                        else
                        {
                            <div class="mb-4 d-flex align-items-end align-items-center">
                                <div class="form-floating flex-grow-1 me-2">
                                    <input asp-for="Email" class="form-control" disabled />
                                    <label asp-for="Email">Current Email</label>
                                </div>
                                <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn btn-lg btn-outline-primary">
                                    Verify
                                </button>
                            </div>
                        }

                        <div class="form-floating mb-3">
                            <input asp-for="Input.NewEmail" type="email" class="form-control" autocomplete="email" />
                            <label asp-for="Input.NewEmail">New Email</label>
                            <span asp-validation-for="Input.NewEmail" class="text-danger small"></span>
                        </div>

                        <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="btn btn-primary w-100 btn-lg">
                            <i class="fa-solid fa-envelope-circle-check me-2"></i> Change Email
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
