@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Personal Data";
}

<div class="container py-5">
    <div class="text-center mb-4">
        <h2 class="fw-bold">@ViewData["Title"]</h2>
        <p class="text-muted">Download or permanently delete your personal data</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-4">
                    <p>Your account contains personal data that you have provided. You can <strong>download</strong> or <strong>permanently delete</strong> it.</p>
                    <p class="text-danger small">⚠️ Deleting your data will also delete your account and cannot be undone.</p>

                    <div class="d-flex gap-2 mt-3">
                        <a asp-page="DownloadPersonalData" class="btn btn-outline-primary">
                            <i class="fa-solid fa-download me-2"></i> Download Data
                        </a>
                        <a asp-page="DeletePersonalData" class="btn btn-danger">
                            <i class="fa-solid fa-trash me-2"></i> Delete Account
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
