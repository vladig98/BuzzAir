@page
@model ShowRecoveryCodesModel

@{
    ViewData["Title"] = "Recovery Codes";
}

<div class="container py-5">
    <h3 class="mb-4">
        <i class="fas fa-shield-alt text-success me-2"></i> Recovery Codes
    </h3>
    <partial name="_StatusMessage" for="StatusMessage" />

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="alert alert-info d-flex align-items-start">
                <i class="fas fa-info-circle fa-2x me-3"></i>
                <div>
                    <strong>Keep these safe.</strong> Losing them may result in account lockout.
                </div>
            </div>

            <div class="row row-cols-2 g-3 mt-3">
                @foreach (var code in Model.RecoveryCodes)
                {
                    <div class="col">
                        <div class="bg-light border rounded p-3 text-center">
                            <code class="fw-bold fs-5">@code</code>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

