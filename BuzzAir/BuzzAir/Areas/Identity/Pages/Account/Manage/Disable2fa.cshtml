@page
@model Disable2faModel
@{
    ViewData["Title"] = "Disable Two-Factor Authentication (2FA)";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-warning text-dark rounded-top-4">
                    <i class="fas fa-shield-alt me-2"></i> Two-Factor Authentication
                </div>
                <div class="card-body p-4">
                    <partial name="_StatusMessage" for="StatusMessage" />

                    <div class="alert alert-warning d-flex align-items-start mb-4" role="alert">
                        <i class="fas fa-exclamation-circle fa-lg me-3"></i>
                        <div>
                            <strong>Warning:</strong> This action will disable 2FA.
                            It does not reset your authenticator app keys.
                            To reset keys, <a asp-page="./ResetAuthenticator">click here</a>.
                        </div>
                    </div>

                    <form method="post" class="text-center">
                        <button type="submit" class="btn btn-danger btn-lg rounded-pill px-5">
                            <i class="fas fa-ban me-1"></i> Disable 2FA
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
