@page
@model EnableAuthenticatorModel

@{
    ViewData["Title"] = "Configure Authenticator App";
}

<div class="container py-5">
    <h3 class="mb-4">
        <i class="fas fa-mobile-alt text-primary me-2"></i> @ViewData["Title"]
    </h3>
    <partial name="_StatusMessage" for="StatusMessage" />

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <ol class="list-unstyled">
                <li class="mb-4">
                    <h5 class="fw-bold">1. Download an Authenticator App</h5>
                    <ul class="list-inline mt-2">
                        <li class="list-inline-item me-3">
                            <i class="fab fa-google-play text-success"></i>
                            <a href="https://go.microsoft.com/fwlink/?Linkid=825072" target="_blank">Microsoft Authenticator (Android)</a>
                        </li>
                        <li class="list-inline-item me-3">
                            <i class="fab fa-app-store text-primary"></i>
                            <a href="https://go.microsoft.com/fwlink/?Linkid=825073" target="_blank">Microsoft Authenticator (iOS)</a>
                        </li>
                        <li class="list-inline-item me-3">
                            <i class="fab fa-google-play text-success"></i>
                            <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2" target="_blank">Google Authenticator (Android)</a>
                        </li>
                        <li class="list-inline-item">
                            <i class="fab fa-app-store text-primary"></i>
                            <a href="https://itunes.apple.com/us/app/google-authenticator/id388497605?mt=8" target="_blank">Google Authenticator (iOS)</a>
                        </li>
                    </ul>
                </li>

                <li class="mb-4">
                    <h5 class="fw-bold">2. Scan the QR Code</h5>
                    <p class="text-muted">Or manually enter this key:</p>
                    <kbd class="bg-light text-primary px-3 py-2 rounded">@Model.SharedKey</kbd>
                    <div class="d-flex justify-content-center my-3">
                        <div id="qrCode"></div>
                    </div>
                    <div id="qrCodeData" data-url="@Model.AuthenticatorUri" class="d-none"></div>
                </li>

                <li>
                    <h5 class="fw-bold">3. Verify Setup</h5>
                    <p class="text-muted">Enter the 6-digit code generated by your app.</p>
                    <form id="send-code" method="post" novalidate class="row justify-content-center">
                        <div class="col-md-6">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                            <div class="form-floating mb-3">
                                <input asp-for="Input.Code" class="form-control" placeholder="123456" autocomplete="off" />
                                <label asp-for="Input.Code">Verification Code</label>
                                <span asp-validation-for="Input.Code" class="text-danger small"></span>
                            </div>
                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="fas fa-check me-2"></i> Verify
                                </button>
                            </div>
                        </div>
                    </form>
                </li>
            </ol>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/qrcodejs/qrcode.js"></script>
    <script src="~/js/qr.js"></script>
}
