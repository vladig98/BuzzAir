@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="container py-5">
    <div class="text-center mb-4">
        <h2 class="fw-bold">@ViewData["Title"]</h2>
        <p class="text-muted">Secure your account by updating your password</p>
    </div>

    <partial name="_StatusMessage" for="StatusMessage" />

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-4">
                    <form id="change-password-form" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.OldPassword" type="password" class="form-control" autocomplete="current-password" />
                            <label asp-for="Input.OldPassword">Current Password</label>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.NewPassword" type="password" class="form-control" autocomplete="new-password" />
                            <label asp-for="Input.NewPassword">New Password</label>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                            <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 btn-lg">
                            <i class="fa-solid fa-lock me-2"></i> Update Password
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
