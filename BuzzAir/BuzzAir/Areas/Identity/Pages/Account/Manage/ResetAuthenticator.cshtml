@page
@model ResetAuthenticatorModel

@{
    ViewData["Title"] = "Reset Authenticator Key";
}

<div class="container py-5">
    <h3 class="mb-4">
        <i class="fas fa-redo-alt text-danger me-2"></i> Reset Authenticator Key
    </h3>
    <partial name="_StatusMessage" for="StatusMessage" />

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="alert alert-warning d-flex align-items-start">
                <i class="fas fa-exclamation-triangle fa-2x me-3"></i>
                <div>
                    <strong class="d-block mb-1">Warning!</strong>
                    Resetting your key disables 2FA until you reconfigure the authenticator app.
                </div>
            </div>
            <form method="post" class="text-center">
                <button type="submit" class="btn btn-danger btn-lg">
                    <i class="fas fa-sync-alt me-2"></i> Reset Key
                </button>
            </form>
        </div>
    </div>
</div>