@page
@model DownloadPersonalDataModel
@{
    ViewData["Title"] = "Download Your Data";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-info text-white rounded-top-4">
                    <i class="fas fa-download me-2"></i> Download Your Data
                </div>
                <div class="card-body p-4 text-center">
                    <p class="text-muted mb-4">
                        You can download a copy of your personal data in a secure JSON format.
                        This may take a few moments depending on account size.
                    </p>

                    <form method="post">
                        <button type="submit" class="btn btn-info btn-lg text-white rounded-pill px-5">
                            <i class="fas fa-file-download me-2"></i> Request Download
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
