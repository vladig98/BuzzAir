@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
}

<div class="container py-5">
    <div class="text-center mb-4">
        <h2 class="fw-bold">@ViewData["Title"]</h2>
        <p class="text-muted">Update your account details and contact information</p>
    </div>

    <partial name="_StatusMessage" for="StatusMessage" />

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-4">
                    <form id="profile-form" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Username" class="form-control" disabled />
                            <label asp-for="Username"></label>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.PhoneNumber" type="tel" class="form-control" />
                            <label asp-for="Input.PhoneNumber"></label>
                            <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                        </div>

                        <button id="update-profile-button" type="submit" class="btn btn-primary w-100 btn-lg">
                            <i class="fa-solid fa-floppy-disk me-2"></i> Save Changes
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
