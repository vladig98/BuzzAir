@model CreateAirportVM

@{
    ViewData["Title"] = "Create Airport";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-xl-6 col-lg-8 col-md-10">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title mb-0">Create Airport</h3>
                </div>

                <div class="card-body">
                    <form asp-area="Admin" asp-controller="Airport" asp-action="Create" method="post" novalidate>
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-12">
                                <div class="form-floating">
                                    <input asp-for="Name" class="form-control" placeholder="Airport name" />
                                    <label asp-for="Name">Airport Name</label>
                                    <span asp-validation-for="Name" class="invalid-feedback d-block"></span>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="form-floating">
                                    <input asp-for="ICAO" class="form-control text-uppercase" placeholder="ICAO" maxlength="4" />
                                    <label asp-for="ICAO">ICAO</label>
                                    <span asp-validation-for="ICAO" class="invalid-feedback d-block"></span>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="form-floating">
                                    <input asp-for="IATA" class="form-control text-uppercase" placeholder="IATA" maxlength="3" />
                                    <label asp-for="IATA">IATA</label>
                                    <span asp-validation-for="IATA" class="invalid-feedback d-block"></span>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="form-floating">
                                    <input asp-for="Latitude"
                                           class="form-control"
                                           placeholder="Latitude"
                                           type="number"
                                           step="0.000001"
                                           min="-90"
                                           max="90" />
                                    <label asp-for="Latitude">Latitude (°)</label>
                                    <span asp-validation-for="Latitude" class="invalid-feedback d-block"></span>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="form-floating">
                                    <input asp-for="Longitude"
                                           class="form-control"
                                           placeholder="Longitude"
                                           type="number"
                                           step="0.000001"
                                           min="-180"
                                           max="180" />
                                    <label asp-for="Longitude">Longitude (°)</label>
                                    <span asp-validation-for="Longitude" class="invalid-feedback d-block"></span>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="form-floating">
                                    <input asp-for="ElevationAboveSeaLevel"
                                           class="form-control"
                                           placeholder="Elevation"
                                           type="number"
                                           step="1"
                                           min="-500"
                                           max="10000" />
                                    <label asp-for="ElevationAboveSeaLevel">Elevation (m)</label>
                                    <span asp-validation-for="ElevationAboveSeaLevel" class="invalid-feedback d-block"></span>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="position-relative form-floating" style="max-width: 500px;">
                                    <input type="hidden" id="CityId" name="CityId" required />
                                    <input type="text" id="cityAirport" class="form-control" placeholder="City" autocomplete="off" />
                                    <label for="cityAirport">City</label>
                                    <span asp-validation-for="CityId" class="invalid-feedback d-block"></span>

                                    <div id="cityAirportResults"
                                         class="border rounded p-2 bg-white position-absolute w-100"
                                         style="max-height: 300px; overflow-y: auto; z-index: 1050; top: 100%; left: 0; display: none;">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 text-end">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-plus-lg"></i> Create Airport
                            </button>
                            <a asp-area="Admin"
                               asp-controller="Airport"
                               asp-action="Index"
                               asp-route-pageNumber="1"
                               class="btn btn-secondary ms-2">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/citiesSearch.js"></script>
}