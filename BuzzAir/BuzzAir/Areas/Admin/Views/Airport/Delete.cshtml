@using BuzzAir.Areas.Admin.ViewModels
@using BuzzAir.Areas.Admin.ViewModels.AirportDTOs
@model DeleteAirportVM

<h2 class="text-center border-bottom border-3 pb-3 mt-3">Delete Airport</h2>

<form method="post" class="w-50 mx-auto" asp-area="Admin" asp-controller="Airport" asp-action="Delete" asp-route-id="">
    @Html.AntiForgeryToken()
    @Html.HiddenFor(x => x.Id)

    <div class="form-floating mb-3">
        <input asp-for="ICAO" class="form-control-plaintext" placeholder="ICAO" readonly = "readonly" />
        <label asp-for="ICAO">ICAO</label>
        <span class="text-danger">@Html.ValidationMessageFor(x => x.ICAO)</span>
    </div>

    <div class="form-floating mb-3">
        <input asp-for="IATA" class="form-control-plaintext" placeholder="IATA" readonly="readonly" />
        <label asp-for="IATA">IATA</label>
        <span class="text-danger">@Html.ValidationMessageFor(x => x.IATA)</span>
    </div>

    <div class="form-floating mb-4">
        <input asp-for="Name" class="form-control-plaintext" placeholder="Airport Name" readonly="readonly" />
        <label asp-for="Name">Name</label>
        <span class="text-danger">@Html.ValidationMessageFor(x => x.Name)</span>
    </div>

    <div class="form-floating mb-4">
        <input asp-for="Country" class="form-control-plaintext" placeholder="Country" readonly="readonly" />
        <label asp-for="Country">Country</label>
        <span class="text-danger">@Html.ValidationMessageFor(x => x.Country)</span>
    </div>

    @if (!string.IsNullOrEmpty(Model.State))
    {
        <div class="form-floating mb-4">
            <input asp-for="State" class="form-control-plaintext" placeholder="State" readonly="readonly" />
            <label asp-for="State">State</label>
            <span class="text-danger">@Html.ValidationMessageFor(x => x.State)</span>
        </div>
    }

    <div class="form-floating mb-4">
        <input asp-for="City" class="form-control-plaintext" placeholder="City" readonly="readonly" />
        <label asp-for="City">City</label>
        <span class="text-danger">@Html.ValidationMessageFor(x => x.City)</span>
    </div>

    <div class="form-floating mb-4">
        <input asp-for="Elevation" class="form-control-plaintext" placeholder="Elevation" readonly="readonly" />
        <label asp-for="Elevation">Elevation</label>
        <span class="text-danger">@Html.ValidationMessageFor(x => x.Elevation)</span>
    </div>

    <div class="form-floating mb-4">
        <input asp-for="Latitude" class="form-control-plaintext" placeholder="Latitude" readonly="readonly" />
        <label asp-for="Latitude">Latitude</label>
        <span class="text-danger">@Html.ValidationMessageFor(x => x.Latitude)</span>
    </div>

    <div class="form-floating mb-4">
        <input asp-for="Longitude" class="form-control-plaintext" placeholder="Longitude" readonly = "readonly" />
        <label asp-for="Longitude">Longitude</label>
        <span class="text-danger">@Html.ValidationMessageFor(x => x.Longitude)</span>
    </div>

    <div class="form-floating mb-4">
        <input asp-for="Timezone" class="form-control-plaintext" placeholder="Timezone" readonly="readonly" />
        <label asp-for="Timezone">Timezone</label>
        <span class="text-danger">@Html.ValidationMessageFor(x => x.Timezone)</span>
    </div>

    <div class="text-end">
        <button type="submit" class="btn btn-danger">Delete</button>
    </div>
</form>
