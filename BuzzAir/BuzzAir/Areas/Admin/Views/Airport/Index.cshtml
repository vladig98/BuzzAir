@model PaginatedList<AirportDTO>

@{
    ViewData["Title"] = "Airports";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Airports</h1>
        <a asp-area="Admin" asp-controller="Airport" asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-lg"></i> Add Airport
        </a>
    </div>

    <div class="row g-4 mb-5">
        @foreach (AirportDTO a in Model)
        {
            <div class="col-sm-6 col-md-4">
                <div class="card h-100 bg-light shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@a.Name</h5>
                        <p class="card-text mb-1"><strong>ICAO:</strong> @a.ICAO</p>
                        <p class="card-text mb-1"><strong>IATA:</strong> @a.IATA</p>
                        <p class="card-text mb-1"><strong>City:</strong> @a.City</p>
                        <p class="card-text mb-1">
                            <strong>Coords:</strong>
                            @(a.Latitude.HasValue && a.Longitude.HasValue ? $"{a.Latitude.Value:#.######}, {a.Longitude.Value:#.######}" : "N/A")
                        </p>
                        <p class="card-text mb-2"><strong>Elevation:</strong> @(a.ElevationAboveSeaLevel?.ToString() ?? "N/A") m</p>

                        <div class="d-flex justify-content-between">
                            <a asp-area="Admin" asp-controller="Airport" asp-action="Edit" asp-route-id="@a.Id" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <a asp-area="Admin" asp-controller="Airport" asp-action="Delete" asp-route-id="@a.Id" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @await Html.PartialAsync("_Pagination", (Model.PageIndex, Model.TotalPages, "Admin", "Airport", "Index"))
</div>
