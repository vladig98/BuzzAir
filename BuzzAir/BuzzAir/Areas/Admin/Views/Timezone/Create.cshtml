@model CreateTimezoneVM

@{
    ViewData["Title"] = "Create Timezone";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-xl-6 col-lg-8 col-md-10">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title mb-0">Create Timezone</h3>
                </div>
                <div class="card-body">
                    <form asp-area="Admin" asp-controller="Timezone" asp-action="Create" method="post" novalidate>
                        <div class="row g-3">

                            <div class="col-12">
                                <div class="form-floating">
                                    <input asp-for="Name" class="form-control" placeholder="Timezone name" />
                                    <label asp-for="Name">Timezone Name</label>
                                    <span asp-validation-for="Name" class="invalid-feedback d-block"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Identifier" class="form-control" placeholder="Identifier (e.g. Europe/Sofia)" />
                                    <label asp-for="Identifier">Identifier</label>
                                    <span asp-validation-for="Identifier" class="invalid-feedback d-block"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Abbreviation" class="form-control" placeholder="EET" />
                                    <label asp-for="Abbreviation">Abbreviation</label>
                                    <span asp-validation-for="Abbreviation" class="invalid-feedback d-block"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Offset" class="form-control" placeholder="+02:00" />
                                    <label asp-for="Offset">Offset (hh:mm, e.g. +02:00)</label>
                                    <span asp-validation-for="Offset" class="invalid-feedback d-block"></span>
                                </div>
                            </div>

                            <div class="col-md-6 d-flex align-items-center">
                                <div class="form-check form-switch">
                                    <input asp-for="UsesDST" class="form-check-input" type="checkbox" />
                                    <label asp-for="UsesDST" class="form-check-label">Uses DST?</label>
                                    <span asp-validation-for="UsesDST" class="invalid-feedback d-block"></span>
                                </div>
                            </div>

                        </div>

                        <div class="mt-4 text-end">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-plus-lg"></i> Create Timezone
                            </button>
                            <a asp-area="Admin"
                               asp-controller="Timezone"
                               asp-action="Index"
                               asp-route-pageNumber="1"
                               class="btn btn-secondary ms-2">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
