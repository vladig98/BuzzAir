@model PaginatedList<TimezoneDTO>

@{
    ViewData["Title"] = "Timezones";

    List<TimezoneDTO> usesDst = Model.Where(t => t.UsesDST).ToList();
    List<TimezoneDTO> noDst = Model.Where(t => !t.UsesDST).ToList();
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Timezones</h1>
        <a asp-area="Admin" asp-controller="Timezone" asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-lg"></i> Add Timezone
        </a>
    </div>

    @* Uses DST *@
    @if (usesDst.Count > 0)
    {
        <h3 class="text-success">Uses DST</h3>
        <div class="row g-4 mb-5">
            @foreach (TimezoneDTO tz in usesDst)
            {
                <div class="col-sm-6 col-md-4">
                    <div class="card h-100 bg-light shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">@tz.Name</h5>
                            <p class="card-text mb-1"><strong>Identifier:</strong> @tz.Identifier</p>
                            <p class="card-text mb-1"><strong>Abbrev:</strong> @tz.Abbreviation</p>
                            <p class="card-text mb-2">
                                <strong>Offset:</strong>
                                @{
                                    var sign = tz.Offset < TimeSpan.Zero ? "-" : "+";
                                    var abs = TimeSpan.FromTicks(Math.Abs(tz.Offset.Ticks));
                                }
                                @($"{sign}{abs.ToString(@"hh\:mm")}")
                            </p>
                            <div class="d-flex justify-content-between">
                                <a asp-area="Admin" asp-controller="Timezone" asp-action="Edit" asp-route-id="@tz.Id" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <a asp-area="Admin" asp-controller="Timezone" asp-action="Delete" asp-route-id="@tz.Id" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @* Does not use DST *@
    @if (noDst.Count > 0)
    {
        <h3 class="text-secondary">Does not use DST</h3>
        <div class="row g-4 mb-5">
            @foreach (TimezoneDTO tz in noDst)
            {
                <div class="col-sm-6 col-md-4">
                    <div class="card h-100 bg-light shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">@tz.Name</h5>
                            <p class="card-text mb-1"><strong>Identifier:</strong> @tz.Identifier</p>
                            <p class="card-text mb-1"><strong>Abbrev:</strong> @tz.Abbreviation</p>
                            <p class="card-text mb-2">
                                <strong>Offset:</strong>
                                @{
                                    var sign = tz.Offset < TimeSpan.Zero ? "-" : "+";
                                    var abs = TimeSpan.FromTicks(Math.Abs(tz.Offset.Ticks));
                                }
                                @($"{sign}{abs.ToString(@"hh\:mm")}")
                            </p>
                            <div class="d-flex justify-content-between">
                                <a asp-area="Admin" asp-controller="Timezone" asp-action="Edit" asp-route-id="@tz.Id" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <a asp-area="Admin" asp-controller="Timezone" asp-action="Delete" asp-route-id="@tz.Id" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @await Html.PartialAsync("_Pagination", (Model.PageIndex, Model.TotalPages, "Admin", "Timezone", "Index"))
</div>
