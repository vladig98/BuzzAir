@using BuzzAir.Areas.Admin.ViewModels
@using BuzzAir.Areas.Admin.ViewModels.StateDTOs
@model CreateStateVM

<h2 class="text-center border-bottom border-3 pb-3 mt-3">Create City</h2>

<form method="post" class="w-50 mx-auto" asp-area="Admin" asp-controller="State" asp-action="Create">
    @Html.AntiForgeryToken()

    <div class="form-floating mb-3">
        <input asp-for="Name" class="form-control" placeholder="Name" />
        <label asp-for="Name">Name</label>
        <span class="text-danger">@Html.ValidationMessageFor(x => x.Name)</span>
    </div>

    <div class="row g-2 mb-3">
        <div class="col form-floating">
            <select asp-for="CountryId" asp-items="Model.CountryOptions" class="form-select">
                <option selected disabled value="">Country</option>
            </select>
            <label asp-for="CountryId">Country</label>
            <span class="text-danger">@Html.ValidationMessageFor(x => x.CountryId)</span>
        </div>
    </div>

    <div class="text-end">
        <button type="submit" class="btn btn-dark">Create</button>
    </div>
</form>

@section Scripts {
    <script src="~/js/selectAirport.js"></script>
}
