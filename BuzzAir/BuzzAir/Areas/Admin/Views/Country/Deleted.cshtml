@model PaginatedList<CountryDTO>

@{
    ViewData["Title"] = "Deleted Countries";

    List<CountryDTO> official = [.. Model.Where(c => c.IsOfficiallyRecognizedCountry)];
    List<CountryDTO> deps = [.. Model.Where(c => !c.IsOfficiallyRecognizedCountry)];
}

<div class="container py-4">
    <h1 class="mb-4">Deleted Countries</h1>

    @* Official ones *@
    @if (official.Count > 0)
    {
        <h3 class="text-success">Officially Recognized Countries</h3>
        <div class="row g-4 mb-5">
            @foreach (CountryDTO country in official)
            {
                <div class="col-sm-6 col-md-4">
                    <div class="card h-100 bg-light shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">@country.Name</h5>
                            <p class="card-text mb-1"><strong>ISO2:</strong> @country.Iso2</p>
                            <p class="card-text mb-1"><strong>ISO3:</strong> @country.Iso3</p>
                            <a asp-area="Admin"
                               asp-controller="Country"
                               asp-action="Restore"
                               asp-route-id="@country.Id"
                               class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-arrow-counterclockwise"></i> Restore
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @* Dependencies *@
    @if (deps.Count > 0)
    {
        <h3 class="text-secondary">Territories / Dependencies</h3>
        <div class="row g-4 mb-5">
            @foreach (CountryDTO country in deps)
            {
                <div class="col-sm-6 col-md-4">
                    <div class="card h-100 bg-light shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">@country.Name</h5>
                            <p class="card-text mb-1"><strong>ISO2:</strong> @country.Iso2</p>
                            <p class="card-text mb-1"><strong>ISO3:</strong> @country.Iso3</p>
                            <a asp-area="Admin"
                               asp-controller="Country"
                               asp-action="Restore"
                               asp-route-id="@country.Id"
                               class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-arrow-counterclockwise"></i> Restore
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @await Html.PartialAsync("_Pagination", (Model.PageIndex, Model.TotalPages, "Admin", "Country", "Deleted"))
</div>