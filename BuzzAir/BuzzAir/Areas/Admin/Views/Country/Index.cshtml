@model PaginatedList<CountryDTO>

@{
    ViewData["Title"] = "Countries";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Countries</h1>
        <a asp-area="Admin" asp-controller="Country" asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-lg"></i> Add Country
        </a>
    </div>

    <div class="row g-4">
        @foreach (CountryDTO country in Model)
        {
            <div class="col-sm-6 col-md-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@country.Name</h5>
                        <p class="card-text mb-1"><strong>ISO:</strong> @country.ISO</p>
                        <p class="card-text mb-3"><strong>Officially Recognized as Country:</strong> @country.IsOfficiallyRecognizedCountry</p>
                        <div class="d-flex justify-content-between">
                            <a asp-area="Admin" asp-controller="Country" asp-action="Edit" asp-route-id="@country.Id" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <a asp-area="Admin" asp-controller="Country" asp-action="Delete" asp-route-id="@country.Id" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-pencil"></i> Delete
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @await Html.PartialAsync("_Pagination", (Model.PageIndex, Model.TotalPages, "Admin", "Country", "Index"))
</div>