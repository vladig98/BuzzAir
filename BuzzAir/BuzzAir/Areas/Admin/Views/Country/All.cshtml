@using BuzzAir.Areas.Admin.ViewModels
@using BuzzAir.Areas.Admin.ViewModels.CountryDTOs
@model PaginatedList<CountryDTO>

<h2 class="text-center border-bottom border-dark-subtle border-3 pb-3 mt-3 border-opacity-100">All Countries</h2>

<table class="table table-primary table-striped table-hover w-75 mx-auto">
    <thead>
        <tr class="fw-bolder">
            <th>#</th>
            <th>Name</th>
            <th>ISO</th>
            <th>Is Country</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @for (var i = 0; i < Model.Count; i++)
        {
            var country = Model[i];
            <tr>
                <td>@((@Model.PageIndex * Model.Count) + (i + 1))</td>
                <td>@country.Name</td>
                <td>@country.ISO</td>
                <td>@country.IsCountry</td>
                <td>
                    <div class="d-flex justify-content-evenly">
                        <a class="btn btn-primary" asp-area="Admin" asp-controller="Country" asp-action="Edit" asp-route-id="@country.Id">Edit</a>
                        <a class="btn btn-danger" asp-area="Admin" asp-controller="Country" asp-action="Delete" asp-route-id="@country.Id">Delete</a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
    <tfoot>
        @{
            var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
            var nextDisabled = !Model.HasNextPage ? "disabled" : "";
        }
        <tr>
            <td colspan="12" class="text-end">
                <a asp-controller="Country" asp-action="All" asp-route-pageNumber="@(Model.PageIndex - 1)" class="btn btn-primary @prevDisabled">
                    Previous
                </a>
                <a asp-controller="Country" asp-action="All" asp-route-pageNumber="@(Model.PageIndex + 1)" class="btn btn-primary @nextDisabled">
                    Next
                </a>
            </td>
        </tr>
    </tfoot>
</table>