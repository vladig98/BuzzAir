@model PaginatedList<FlightDTO>

@{
    ViewData["Title"] = "Deleted Flights";
}

<div class="container py-4">
    <h1 class="mb-4">Deleted Flights</h1>

    <div class="row g-4 mb-5">
        @foreach (var f in Model)
        {
            <div class="col-sm-6 col-md-4">
                <div class="card h-100 bg-light shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@f.FlightNumber</h5>
                        <p class="card-text mb-1"><strong>Route:</strong> @f.Origin → @f.Destionation</p>
                        <p class="card-text mb-1"><strong>Departure:</strong> @f.DepartureUTC.ToString("yyyy-MM-dd HH:mm") UTC</p>
                        <p class="card-text mb-1"><strong>Arrival:</strong> @f.ArrivalUTC.ToString("yyyy-MM-dd HH:mm") UTC</p>
                        <p class="card-text mb-2"><strong>Aircraft:</strong> @f.AircraftModel</p>
                        <p class="card-text mb-2"><strong>Price:</strong> € @f.PriceInEur</p>

                        <a asp-area="Admin" asp-controller="Flight" asp-action="Restore" asp-route-id="@f.Id" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-arrow-counterclockwise"></i> Restore
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    @await Html.PartialAsync("_Pagination", (Model.PageIndex, Model.TotalPages, "Admin", "Flight", "Deleted"))
</div>
