@model CreateFlightVM

@{
    ViewData["Title"] = "Create Flight";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10 col-md-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title mb-0">Create Flight</h3>
                </div>
                <div class="card-body">
                    <form asp-area="Admin" asp-controller="Flight" asp-action="Create" method="post" novalidate>
                        <div class="row g-3">

                            <div class="col-md-4">
                                <div class="form-floating">
                                    <input asp-for="FlightNumber" class="form-control" placeholder="Flight number" />
                                    <label asp-for="FlightNumber">Flight Number</label>
                                    <span asp-validation-for="FlightNumber" class="invalid-feedback d-block"></span>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="form-floating">
                                    <select asp-for="OriginId" asp-items="Model.OriginAirports" class="form-select">
                                        <option selected hidden disabled value="">Select origin</option>
                                    </select>
                                    <label asp-for="OriginId">Origin Airport</label>
                                    <span asp-validation-for="OriginId" class="invalid-feedback d-block"></span>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="form-floating">
                                    <select asp-for="DestinationId" asp-items="Model.DestinationAirports" class="form-select">
                                        <option selected hidden disabled value="">Select destination</option>
                                    </select>
                                    <label asp-for="DestinationId">Destination Airport</label>
                                    <span asp-validation-for="DestinationId" class="invalid-feedback d-block"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="AircraftId" asp-items="Model.Aircraft" class="form-select">
                                        <option selected hidden disabled value="">Select aircraft</option>
                                    </select>
                                    <label asp-for="AircraftId">Aircraft</label>
                                    <span asp-validation-for="AircraftId" class="invalid-feedback d-block"></span>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="form-floating">
                                    <input asp-for="DepartureUTC" class="form-control" type="datetime-local" />
                                    <label asp-for="DepartureUTC">Departure (UTC)</label>
                                    <span asp-validation-for="DepartureUTC" class="invalid-feedback d-block"></span>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="form-floating">
                                    <input asp-for="ArrivalUTC" class="form-control" type="datetime-local" />
                                    <label asp-for="ArrivalUTC">Arrival (UTC)</label>
                                    <span asp-validation-for="ArrivalUTC" class="invalid-feedback d-block"></span>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="form-floating">
                                    <input asp-for="PriceInEur" class="form-control" placeholder="Price in EUR" type="number" step="0.01" />
                                    <label asp-for="PriceInEur">Price (EUR)</label>
                                    <span asp-validation-for="PriceInEur" class="invalid-feedback d-block"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 text-end">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-plus-lg"></i> Create Flight
                            </button>
                            <a asp-area="Admin" asp-controller="Flight" asp-action="Index" asp-route-pageNumber="1" class="btn btn-secondary ms-2">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
