@model DeleteFlightVM

@{
    ViewData["Title"] = "Delete Flight";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-danger shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">Delete Flight</h5>
                </div>
                <div class="card-body">
                    <form asp-area="Admin" asp-controller="Flight" asp-action="Delete" method="post" class="row g-3">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="FlightNumber" />
                        <input type="hidden" asp-for="OriginName" />
                        <input type="hidden" asp-for="DestinationName" />
                        <input type="hidden" asp-for="DepartureUTC" value="@Model.DepartureUTC.ToString("o")" />
                        <input type="hidden" asp-for="ArrivalUTC" value="@Model.ArrivalUTC.ToString("o")" />
                        <input type="hidden" asp-for="AircraftModel" />
                        <input type="hidden" asp-for="PriceInEur" />

                        <div class="col-12 form-floating">
                            <input asp-for="FlightNumber" class="form-control disabled" disabled readonly />
                            <label asp-for="FlightNumber">Flight</label>
                        </div>

                        <div class="col-md-6 form-floating">
                            <input asp-for="OriginName" class="form-control disabled" disabled readonly />
                            <label asp-for="OriginName">Origin</label>
                        </div>

                        <div class="col-md-6 form-floating">
                            <input asp-for="DestinationName" class="form-control disabled" disabled readonly />
                            <label asp-for="DestinationName">Destination</label>
                        </div>

                        <div class="col-md-6 form-floating">
                            <input asp-for="AircraftModel" class="form-control disabled" disabled readonly />
                            <label asp-for="AircraftModel">Aircraft Model</label>
                        </div>

                        <div class="col-md-6 form-floating">
                            <input asp-for="DepartureUTC" class="form-control disabled" disabled readonly />
                            <label asp-for="DepartureUTC">Departure (UTC)</label>
                        </div>

                        <div class="col-md-6 form-floating">
                            <input asp-for="ArrivalUTC" class="form-control disabled" disabled readonly />
                            <label asp-for="ArrivalUTC">Arrival (UTC)</label>
                        </div>

                        <div class="col-md-6 form-floating">
                            <input asp-for="PriceInEur" class="form-control disabled" disabled readonly />
                            <label asp-for="PriceInEur">Price (EUR)</label>
                        </div>

                        <div class="col-12 text-end">
                            <button type="submit" name="hard" value="false" class="btn btn-warning">Delete</button>
                            <button type="submit" name="hard" value="true" class="btn btn-danger ms-2">Delete Forever</button>
                            <a class="btn btn-secondary" asp-area="Admin" asp-controller="Flight" asp-action="Index" asp-route-pageNumber="1">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
