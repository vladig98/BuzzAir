@using BuzzAir.Areas.Admin.ViewModels
@using BuzzAir.Areas.Admin.ViewModels.AircraftDTOs
@model DeleteAircraftVM

<h2 class="text-center border-bottom border-3 pb-3 mt-3">Delete Aircraft</h2>

<form class="w-50 mx-auto" asp-area="Admin" asp-controller="Aircraft" asp-action="Delete" asp-route-id="" method="post">
    @Html.AntiForgeryToken()
    @Html.HiddenFor(x => x.Id)

    <div class="form-floating mb-3">
        @Html.EditorFor(x => x.Name, new { htmlAttributes = new { @class = "form-control-plaintext", placeholder = "Name", @readonly = "readonly", @autocomplete = Model.Name } })
        @Html.LabelFor(x => x.Name)
        <span class="text-danger">@Html.ValidationMessageFor(x => x.Name)</span>
    </div>

    <div class="form-floating mb-3">
        @Html.EditorFor(x => x.Seats, new { htmlAttributes = new { @class = "form-control-plaintext", placeholder = "Seats", @readonly = "readonly", @autocomplete = Model.Seats } })
        @Html.LabelFor(x => x.Seats)
        <span class="text-danger">@Html.ValidationMessageFor(x => x.Seats)</span>
    </div>

    <div class="text-end">
        <button type="submit" class="btn btn-danger">Delete</button>
    </div>
</form>
