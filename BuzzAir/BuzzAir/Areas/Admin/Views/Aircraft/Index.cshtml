@model PaginatedList<AircraftDTO>

@{
    ViewData["Title"] = "Aircraft";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Aircraft</h1>
        <a asp-area="Admin" asp-controller="Aircraft" asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-lg"></i> Add Aircraft
        </a>
    </div>

    <div class="row g-4 mb-5">
        @foreach (AircraftDTO aircraft in Model)
        {
            <div class="col-sm-6 col-md-4">
                <div class="card h-100 bg-light shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@aircraft.Name</h5>
                        <p class="card-text mb-1"><strong>Number of seats:</strong> @aircraft.NumberOfSeats</p>

                        <div class="d-flex justify-content-between">
                            <a asp-area="Admin" asp-controller="Aircraft" asp-action="Edit" asp-route-id="@aircraft.Id" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <a asp-area="Admin" asp-controller="Aircraft" asp-action="Delete" asp-route-id="@aircraft.Id" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @await Html.PartialAsync("_Pagination", (Model.PageIndex, Model.TotalPages, "Admin", "Aircraft", "Index"))
</div>
