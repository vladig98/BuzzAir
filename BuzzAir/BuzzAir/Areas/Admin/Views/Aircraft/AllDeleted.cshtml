@using BuzzAir.Areas.Admin.ViewModels
@using BuzzAir.Areas.Admin.ViewModels.AircraftDTOs
@model PaginatedList<AircraftDTO>

<h2 class="text-center border-bottom border-3 pb-3 mt-3">All Aircraft</h2>

<table class="table table-striped table-hover w-75 mx-auto">
    <thead class="table-primary">
        <tr class="fw-bold">
            <th>Name</th>
            <th>Number of Seats</th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var aircraft in Model)
        {
            <tr>
                <td>@aircraft.Name</td>
                <td>@aircraft.Seats</td>
                <td class="text-center">
                    <div class="btn-group">
                        <a class="btn btn-outline-primary" asp-controller="Aircraft" asp-action="Restore" asp-route-id="@aircraft.Id">Restore</a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="3" class="text-end">
                <a class="btn btn-secondary @(!Model.HasPreviousPage ? "disabled" : "")"
                   asp-controller="Aircraft" asp-action="All" asp-route-pageNumber="@(Model.PageIndex - 1)">Previous</a>
                <a class="btn btn-secondary @(!Model.HasNextPage ? "disabled" : "")"
                   asp-controller="Aircraft" asp-action="All" asp-route-pageNumber="@(Model.PageIndex + 1)">Next</a>
            </td>
        </tr>
    </tfoot>
</table>
