@model PaginatedList<AircraftDTO>

@{
    ViewData["Title"] = "Deleted Aircraft";
}

<div class="container py-4">
    <h1 class="mb-4">Deleted Aircraft</h1>

    <div class="row g-4 mb-5">
        @foreach (AircraftDTO aircraft in Model)
        {
            <div class="col-sm-6 col-md-4">
                <div class="card h-100 bg-light shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@aircraft.Name</h5>
                        <p class="card-text mb-1"><strong>Number of seats:</strong> @aircraft.NumberOfSeats</p>

                        <a asp-area="Admin"
                           asp-controller="Aircraft"
                           asp-action="Restore"
                           asp-route-id="@aircraft.Id"
                           class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-arrow-counterclockwise"></i> Restore
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    @await Html.PartialAsync("_Pagination", (Model.PageIndex, Model.TotalPages, "Admin", "Aircraft", "Deleted"))
</div>
