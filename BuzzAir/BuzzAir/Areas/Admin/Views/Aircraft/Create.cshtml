@model CreateAircraftVM

@{
    ViewData["Title"] = "Create Aircraft";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-xl-6 col-lg-8 col-md-10">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title mb-0">Create Aircraft</h3>
                </div>
                <div class="card-body">
                    <form asp-area="Admin" asp-controller="Aircraft" asp-action="Create" method="post" novalidate>
                        <div class="row g-3">

                            <div class="col-12">
                                <div class="form-floating">
                                    <input asp-for="Name" class="form-control" placeholder="Aircraft name" />
                                    <label asp-for="Name">Aircraft Name</label>
                                    <span asp-validation-for="Name" class="invalid-feedback d-block"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="NumberOfSeats" class="form-control" placeholder="Number Of Seats" />
                                    <label asp-for="NumberOfSeats">Number Of Seats</label>
                                    <span asp-validation-for="NumberOfSeats" class="invalid-feedback d-block"></span>
                                </div>
                            </div>

                        </div>

                        <div class="mt-4 text-end">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-plus-lg"></i> Create Aircraft
                            </button>
                            <a asp-area="Admin"
                               asp-controller="Aircraft"
                               asp-action="Index"
                               asp-route-pageNumber="1"
                               class="btn btn-secondary ms-2">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
