@model CreateCityVM

@{
    ViewData["Title"] = "Create City";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-xl-6 col-lg-8 col-md-10">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title mb-0">Create City</h3>
                </div>
                <div class="card-body">
                    <form asp-area="Admin" asp-controller="City" asp-action="Create" method="post" novalidate>
                        <div class="row g-3">
                            <div class="col-12">
                                <div class="form-floating">
                                    <input asp-for="Name" class="form-control" placeholder="City name" />
                                    <label asp-for="Name">City Name</label>
                                    <span asp-validation-for="Name" class="invalid-feedback d-block"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="CountryId" asp-items="Model.Countries" class="form-select" id="countrySelect" placeholder="Country">
                                        <option selected disabled hidden value="">Select a country</option>
                                    </select>
                                    <label asp-for="CountryId">Country</label>
                                    <span asp-validation-for="CountryId" class="invalid-feedback d-block"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="StateId" class="form-select" id="stateSelect" placeholder="State" disabled>
                                        <option selected disabled hidden value="">Select a state</option>
                                    </select>
                                    <label asp-for="StateId">State</label>
                                    <span asp-validation-for="StateId" class="invalid-feedback d-block"></span>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="form-floating">
                                    <select asp-for="TimezoneId" asp-items="Model.Timezones" class="form-select" placeholder="Timezone">
                                        <option selected disabled hidden value="">Select a timezone</option>
                                    </select>
                                    <label asp-for="TimezoneId">Timezone</label>
                                    <span asp-validation-for="TimezoneId" class="invalid-feedback d-block"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 text-end">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-plus-lg"></i> Create City
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/getStatesSignalR.js"></script>
}