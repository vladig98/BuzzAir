@model PaginatedList<CityDTO>

@{
    ViewData["Title"] = "Deleted Cities";
}

<div class="container py-4">
    <h1 class="mb-4">Deleted Cities</h1>

    <div class="row g-4">
        @foreach (CityDTO city in Model)
        {
            <div class="col-sm-6 col-md-4">
                <div class="card h-100 bg-light shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title text-muted">@city.Name</h5>
                        <p class="card-text mb-1"><strong>Country:</strong> @city.Country</p>
                        @if (!string.IsNullOrEmpty(city.State))
                        {
                            <p class="card-text mb-1"><strong>State:</strong> @city.State</p>
                        }
                        <p class="card-text mb-3"><strong>Timezone:</strong> @city.Timezone</p>
                        <a asp-area="Admin" asp-controller="City" asp-action="Restore" asp-route-id="@city.Id" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-pencil"></i> Restore
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="City pagination" class="mt-4">
            <ul class="pagination justify-content-center flex-wrap">
                @{
                    int current = Model.PageIndex;
                    int total = Model.TotalPages;

                    // if few pages, show all
                    if (total < 7)
                    {
                        for (int i = 1; i <= total; i++)
                        {
                            <li class="page-item @(i == current ? "active" : "")">
                                <a class="page-link" asp-area="Admin" asp-controller="City" asp-action="Deleted" asp-route-pageNumber="@i">@i</a>
                            </li>
                        }
                    }
                    else
                    {
                        // first 3
                        for (int i = 1; i <= 3; i++)
                        {
                            <li class="page-item @(i == current ? "active" : "")">
                                <a class="page-link" asp-area="Admin" asp-controller="City" asp-action="Deleted" asp-route-pageNumber="@i">@i</a>
                            </li>
                        }

                        // middle?
                        if (current > 4)
                        {
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        }

                        if (current >= 4 && current <= total - 3)
                        {
                            <li class="page-item active">
                                <a class="page-link" asp-area="Admin" asp-controller="City" asp-action="Deleted" asp-route-pageNumber="@current">@current</a>
                            </li>
                        }

                        if (current < total - 3)
                        {
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        }

                        // last 3
                        for (int i = total - 2; i <= total; i++)
                        {
                            <li class="page-item @(i == current ? "active" : "")">
                                <a class="page-link" asp-area="Admin" asp-controller="City" asp-action="Deleted" asp-route-pageNumber="@i">@i</a>
                            </li>
                        }
                    }
                }
            </ul>
        </nav>

        @if (total >= 7)
        {
            <div class="d-flex justify-content-center align-items-center mt-3">
                <span class="me-2">Page</span>
                <form class="d-flex align-items-center"
                      asp-area="Admin" asp-controller="City" asp-action="Deleted" method="get">
                    <input type="number"
                           name="pageNumber"
                           min="1"
                           max="@total"
                           class="form-control form-control-sm"
                           style="width: 80px;"
                           value="@current" />
                    <button type="submit"
                            class="btn btn-sm btn-primary ms-2">
                        Go
                    </button>
                </form>
                <span class="ms-2">out of @total</span>
            </div>
        }
    }
</div>