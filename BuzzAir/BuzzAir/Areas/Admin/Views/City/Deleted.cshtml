@model PaginatedList<CityDTO>

@{
    ViewData["Title"] = "Deleted Cities";
}

<div class="container py-4">
    <h1 class="mb-4">Deleted Cities</h1>

    <div class="row g-4">
        @foreach (CityDTO city in Model)
        {
            <div class="col-sm-6 col-md-4">
                <div class="card h-100 bg-light shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title text-muted">@city.Name</h5>
                        <p class="card-text mb-1"><strong>Country:</strong> @city.Country</p>
                        @if (!string.IsNullOrEmpty(city.State))
                        {
                            <p class="card-text mb-1"><strong>State:</strong> @city.State</p>
                        }
                        <p class="card-text mb-3"><strong>Timezone:</strong> @city.Timezone</p>
                        <a asp-area="Admin" asp-controller="City" asp-action="Restore" asp-route-id="@city.Id" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-pencil"></i> Restore
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    @await Html.PartialAsync("_Pagination", (Model.PageIndex, Model.TotalPages, "Admin", "City", "Deleted"))
</div>