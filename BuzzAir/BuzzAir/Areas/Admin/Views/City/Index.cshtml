@model PaginatedList<CityDTO>

@{
    ViewData["Title"] = "Cities";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Cities</h1>
        <a asp-area="Admin" asp-controller="City" asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-lg"></i> Add City
        </a>
    </div>

    <div class="row g-4">
        @foreach (CityDTO city in Model)
        {
            <div class="col-sm-6 col-md-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@city.Name</h5>
                        <p class="card-text mb-1"><strong>Country:</strong> @city.Country</p>
                        @if (!string.IsNullOrEmpty(city.State))
                        {
                            <p class="card-text mb-1"><strong>State:</strong> @city.State</p>
                        }
                        <p class="card-text mb-3"><strong>Timezone:</strong> @city.Timezone</p>
                        <div class="d-flex justify-content-between">
                            <a asp-area="Admin" asp-controller="City" asp-action="Edit" asp-route-id="@city.Id" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <a asp-area="Admin" asp-controller="City" asp-action="Delete" asp-route-id="@city.Id" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-pencil"></i> Delete
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @await Html.PartialAsync("_Pagination", (Model.PageIndex, Model.TotalPages, "Admin", "City", "Index"))
</div>