@{
    ViewData["Title"] = "Home";
}

@{
    var slides = new[]
    {
        new { Src = Url.Content("~/images/backgrounds/blue sky with clouds and fog.jpg"), Alt = "Blue sky with clouds and fog" },
        new { Src = Url.Content("~/images/backgrounds/blue sky with clouds.jpg"), Alt = "Blue sky with clouds" },
        new { Src = Url.Content("~/images/backgrounds/city and sun.jpg"), Alt = "City and sun" },
        new { Src = Url.Content("~/images/backgrounds/city.jpg"), Alt = "City" },
        new { Src = Url.Content("~/images/backgrounds/geometric reddish band.jpg"), Alt = "Geometric reddish band" },
        new { Src = Url.Content("~/images/backgrounds/geometric.jpg"), Alt = "Geometric" },
        new { Src = Url.Content("~/images/backgrounds/islands.jpg"), Alt = "Islands" },
        new { Src = Url.Content("~/images/backgrounds/luxury one stripe.jpg"), Alt = "Luxury one stripe" },
        new { Src = Url.Content("~/images/backgrounds/luxury.jpg"), Alt = "Luxury" },
        new { Src = Url.Content("~/images/backgrounds/mini islands.jpg"), Alt = "Mini islands" },
        new { Src = Url.Content("~/images/backgrounds/techy brighter.jpg"), Alt = "Techy brighter" },
        new { Src = Url.Content("~/images/backgrounds/techy.jpg"), Alt = "Techy" }
    };
}

<!-- Hero Carousel -->
<div id="carousel" class="carousel slide carousel-fade vh-100" data-bs-ride="carousel" aria-label="Homepage slideshow">
    <div class="carousel-inner h-100">
        @for (int i = 0; i < slides.Length; i++)
        {
            var slide = slides[i];
            <div class="carousel-item h-100 @(i == 0 ? "active" : null)">
                <img src="@slide.Src" class="d-block w-100 h-100 object-fit-cover" alt="@slide.Alt" />
            </div>
        }
    </div>
</div>

<!-- Flight Search Card -->
<div class="search-container position-absolute top-50 start-50 translate-middle w-100 px-3">
    <div class="card shadow-lg border-0 rounded-4 mx-auto" style="max-width: 900px;">
        <div class="card-body p-4">
            <div class="text-center mb-4">
                <i class="fa-solid fa-plane-departure fa-2x text-primary"></i>
                <h2 class="mt-2 fw-bold">Find Your Flight</h2>
            </div>

            <form asp-controller="Booking" asp-action="Create" method="get" id="bookingForm" class="row g-3">

                <!-- Trip Type -->
                <div class="col-12 d-flex justify-content-center gap-4 mb-2">
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="tripType" id="returnTrip" value="Return" checked>
                        <label class="form-check-label" for="returnTrip">Return</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="tripType" id="oneWayTrip" value="OneWay">
                        <label class="form-check-label" for="oneWayTrip">One Way</label>
                    </div>
                </div>

                <!-- From / To -->
                <div class="col-md-6">
                    <div id="originSelector" style="max-width: 500px;">
                        <label for="originAirport" class="form-label">From</label>
                        <input type="hidden" id="originId" name="originId" required />
                        <input type="text" id="originAirport" class="form-control mb-2" placeholder="Type to search airports..." autocomplete="off" />

                        <div id="originAirportResults" class="border rounded p-2 bg-white position-absolute" style="max-height: 300px; overflow-y: auto;">
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div id="destinationSelector" style="max-width: 500px;">
                        <label for="destinationAirport" class="form-label">To</label>
                        <input type="hidden" id="destinationId" name="destinationId" required />
                        <input type="text" id="destinationAirport" class="form-control mb-2" placeholder="Type to search airports..." autocomplete="off" />

                        <div id="destinationAirportResults" class="border rounded p-2 bg-white position-absolute" style="max-height: 300px; overflow-y: auto;">
                        </div>
                    </div>
                </div>

                <!-- Dates -->
                <div class="col-md-6">
                    <label for="departureDate" class="form-label">Departure</label>
                    <input type="date" id="departureDate" name="departureDate" class="form-control" required disabled>
                </div>
                <div class="col-md-6" id="returnDateWrapper">
                    <label for="returnDate" class="form-label">Return</label>
                    <input type="date" id="returnDate" name="returnDate" class="form-control" disabled>
                </div>

                <!-- Passengers Count -->
                <div class="col-md-6">
                    <label for="passengersCount" class="form-label">Passengers</label>
                    <input type="number" value="1" min="1" max="10" id="passengersCount" name="passengersCount" class="form-control" required>
                </div>

                <!-- Search button -->
                <div class="col-12 d-grid mt-3">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="fa-solid fa-magnifying-glass me-2"></i> Search Flights
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/home.js"></script>
    <script src="~/js/originSelect.js"></script>
    <script src="~/js/destinationSelect.js"></script>
}
