@model PaginatedList<Flight>

<h2 class="text-center border-bottom border-3 pb-3 mt-3">Flights</h2>

<table class="table table-striped table-hover w-100 mx-auto">
    <thead class="table-primary">
        <tr class="fw-bold">
            <th>Flight #</th>
            <th>Aircraft</th>
            <th>Origin</th>
            <th>Destination</th>
            <th>Duration</th>
            <th>Departure</th>
            <th>Arrival</th>
            <th>Price</th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var f in Model)
        {
            <tr>
                <td>@f.FlightNumber</td>
                <td>@f.Aircraft.Name</td>
                <td>@f.Origin.IATA</td>
                <td>@f.Destination.IATA</td>
                <td>@f.DurationInMinutes mins</td>
                <td>@f.DepartureUTC.ToString("dd MMM yyyy HH:mm", CultureInfo.InvariantCulture)</td>
                <td>@f.ArrivalUTC.ToString("dd MMM yyyy HH:mm", CultureInfo.InvariantCulture)</td>
                <td>$@f.Price</td>
                <td class="text-center">
                    <div class="btn-group">
                        <a asp-controller="Flight" asp-action="Edit" asp-route-flightId="@f.Id"
                           class="btn btn-outline-primary">Edit</a>
                        <form asp-controller="Flight" asp-action="Delete" asp-route-flightId="@f.Id"
                              method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-danger">Delete</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="9" class="text-end">
                <a asp-controller="Flight" asp-action="All" asp-route-pageNumber="@(Model.PageIndex - 1)"
                   class="btn btn-secondary @(!Model.HasPreviousPage ? "disabled" : "")">Previous</a>
                <a asp-controller="Flight" asp-action="All" asp-route-pageNumber="@(Model.PageIndex + 1)"
                   class="btn btn-secondary @(!Model.HasNextPage ? "disabled" : "")">Next</a>
            </td>
        </tr>
    </tfoot>
</table>
