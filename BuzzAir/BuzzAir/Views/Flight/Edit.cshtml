@model FlightEditViewModel

<h2 class="text-center border-bottom border-3 pb-3 mt-3">Edit Flight</h2>

<form method="post" class="w-50 mx-auto" asp-controller="Flight" asp-action="Edit" novalidate>
    @Html.HiddenFor(x => x.Id)

    <div class="form-floating mb-3">
        @Html.EditorFor(x => x.FlightNumber, new { htmlAttributes = new { @class = "form-control", placeholder = "Flight Number" } })
        @Html.LabelFor(x => x.FlightNumber)
        <span class="text-danger">@Html.ValidationMessageFor(x => x.FlightNumber)</span>
    </div>

    <div class="form-floating mb-3">
        @Html.EditorFor(x => x.DurationInMinutes, new { htmlAttributes = new { @class = "form-control", placeholder = "Duration (minutes)" } })
        @Html.LabelFor(x => x.DurationInMinutes)
        <span class="text-danger">@Html.ValidationMessageFor(x => x.DurationInMinutes)</span>
    </div>

    <div class="form-floating mb-3">
        @Html.EditorFor(x => x.Departure, new { htmlAttributes = new { @class = "form-control", type = "datetime-local" } })
        @Html.LabelFor(x => x.Departure)
        <span class="text-danger">@Html.ValidationMessageFor(x => x.Departure)</span>
    </div>

    <div class="form-floating mb-3">
        @Html.EditorFor(x => x.Price, new { htmlAttributes = new { @class = "form-control", placeholder = "Price" } })
        @Html.LabelFor(x => x.Price)
        <span class="text-danger">@Html.ValidationMessageFor(x => x.Price)</span>
    </div>

    <div class="row g-2 mb-4">
        <div class="col form-floating">
            <select asp-for="OriginCountry" asp-items="Model.OriginOptions" class="form-select">
                <option selected disabled value="">Origin Country</option>
            </select>
            <label asp-for="OriginCountry">Origin Country</label>
        </div>
        <div class="col form-floating">
            <select asp-for="Origin" asp-items="Model.OriginAirportsOptions" class="form-select">
                <option selected disabled value="">Origin Airport</option>
            </select>
            <label asp-for="Origin">Origin Airport</label>
        </div>
    </div>

    <div class="row g-2 mb-4">
        <div class="col form-floating">
            <select asp-for="DestinationCountry" asp-items="Model.DestinationOptions" class="form-select">
                <option selected disabled value="">Destination Country</option>
            </select>
            <label asp-for="DestinationCountry">Destination Country</label>
        </div>
        <div class="col form-floating">
            <select asp-for="Destination" asp-items="Model.DestinationAirportsOptions" class="form-select">
                <option selected disabled value="">Destination Airport</option>
            </select>
            <label asp-for="Destination">Destination Airport</label>
        </div>
    </div>

    <div class="form-floating mb-4">
        <select asp-for="Aircraft" asp-items="Model.AircraftOptions" class="form-select">
            <option selected disabled value="">Select Aircraft</option>
        </select>
        <label asp-for="Aircraft">Aircraft</label>
    </div>

    <div class="text-end">
        <button type="submit" class="btn btn-primary">Update</button>
    </div>
</form>

@section Scripts {
    <script src="~/js/selectFlight.js"></script>
}
