@model CreateBookingDto

<form id="bookingForm" asp-controller="Booking" asp-action="CreateBooking">
    <!-- SECTION 1: FLIGHT SELECTION -->
    <div data-section>
        <h3>Outbound Flights</h3>
        @for (int i = 0; i < Model.OutboundFlights.Count; i++)
        {
            <div class="form-check p-3 border rounded mb-2">
                <input class="form-check-input" type="radio" value="@Model.OutboundFlights[i].Id" name="OutboundId" id="@Model.OutboundFlights[i].Id">
                <label class="form-check-label fw-bold" for="@Model.OutboundFlights[i].Id">
                    @Model.OutboundFlights[i].Origin - @Model.OutboundFlights[i].Destination
                    <p class="text-muted small">
                        @Model.OutboundFlights[i].DepartureUTC - @Model.OutboundFlights[i].ArrivalUTC
                    </p>
                </label>
            </div>
        }

        <h3 class="mt-4">Inbound Flights</h3>
        @for (int i = 0; i < Model.InboundFlights.Count; i++)
        {
            <div class="form-check p-3 border rounded mb-2">
                <input class="form-check-input" type="radio" value="@Model.InboundFlights[i].Id" name="InboundId" id="@Model.InboundFlights[i].Id">
                <label class="form-check-label fw-bold" for="@Model.InboundFlights[i].Id">
                    @Model.InboundFlights[i].Origin - @Model.InboundFlights[i].Destination
                    <p class="text-muted small">
                        @Model.InboundFlights[i].DepartureUTC - @Model.InboundFlights[i].ArrivalUTC
                    </p>
                </label>
            </div>
        }
    </div>

    <!-- SECTION 2: PASSENGERS -->
    <div data-section class="d-none">
        <h3>Passengers</h3>
        @for (int i = 0; i < Model.Passengers.Count; i++)
        {
            <h5>Passenger @(i + 1)</h5>
            <div class="p-3 border rounded mb-4">
                <div class="mb-3">
                    <label for="@($"firstName{i}")" class="form-label">First Name</label>
                    <input name="Passengers[@i].FirstName" type="text" class="form-control" id="@($"firstName{i}")">
                </div>
                <div class="mb-3">
                    <label for="@($"lastName{i}")" class="form-label">Last Name</label>
                    <input name="Passengers[@i].LastName" type="text" class="form-control" id="@($"lastName{i}")">
                </div>
                <div class="mb-3">
                    <label for="@($"dob{i}")" class="form-label">Date of Birth</label>
                    <input name="Passengers[@i].DateOfBirth" type="date" class="form-control" id="@($"dob{i}")">
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" value="Male" name="Passengers[@i].Gender" id="@($"male{i}")">
                    <label class="form-check-label" for="@($"male{i}")">Male</label>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="radio" value="Female" name="Passengers[@i].Gender" id="@($"female{i}")">
                    <label class="form-check-label" for="@($"female{i}")">Female</label>
                </div>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="@($"checkInNow{i}")">
                    <label class="form-check-label" for="@($"checkInNow{i}")">Check in now</label>
                </div>

                <!-- Hidden travel document details -->
                <div class="d-none mt-3 p-3 border rounded">
                    <select name="Passengers[@i].TravelDocument.DocumentType" id="@($"travelDocType{i}")" class="form-select mb-2">
                        <option hidden disabled selected>Select a travel document</option>
                        @foreach (object? item in Enum.GetValues(typeof(DocumentType)))
                        {
                            <option value="@item">@item.ToString()</option>
                        }
                    </select>
                    <input name="Passengers[@i].TravelDocument.Number" type="text" class="form-control mb-2" id="@($"documentNumber{i}")" placeholder="Document Number">
                    <input name="Passengers[@i].TravelDocument.IssueDate" type="date" class="form-control mb-2" id="@($"issueDate{i}")" placeholder="Issue Date">
                    <input name="Passengers[@i].TravelDocument.ExpiryDate" type="date" class="form-control mb-2" id="@($"expiryDate{i}")" placeholder="Expiry Date">
                    <select name="Passengers[@i].TravelDocument.NationalityId" id="@($"nationality{i}")" class="form-select">
                        <option hidden disabled selected>Select your nationality</option>
                        @foreach (SelectListItem country in Model.CountriesSelect)
                        {
                            <option value="@country.Value">@country.Text</option>
                        }
                    </select>
                </div>
            </div>
        }
    </div>

    <!-- SECTION 3: SERVICES -->
    <div data-section class="d-none">
        <h3>Services</h3>
        @for (int i = 0; i < Model.Passengers.Count; i++)
        {
            <h5>Passenger @(i + 1)</h5>
            <div class="d-flex flex-wrap gap-2">
                @foreach (ServiceDto service in Model.Services)
                {
                    <div class="form-check form-check-inline service-pill">
                        <input name="Passengers[@i].ServiceIds" class="form-check-input" type="checkbox" value="@service.Id" id="@($"service{service.Name}{i}")">
                        <label class="form-check-label" for="@($"service{service.Name}{i}")">@service.Name (€@service.Price)</label>
                    </div>
                }
            </div>
            @foreach (ServiceDto bag in Model.BaggageService)
            {
                <div class="form-check">
                    <input name="Passengers[@i].Baggage" class="form-check-input" type="radio" value="@bag.Id" name="@($"baggage{i}")" id="@($"baggage{bag.BaggageType}{i}")">
                    <label class="form-check-label" for="@($"baggage{bag.BaggageType}{i}")">@bag.Name (@bag.Kilos kg) - €@bag.Price</label>
                </div>
            }
            @foreach (ServiceDto seat in Model.SeatsServices)
            {
                <div class="form-check">
                    <input name="Passengers[@i].Seats" class="form-check-input" type="radio" value="@seat.Id" name="@($"seat{i}")" id="@($"seat{seat.SeatType}{i}")">
                    <label class="form-check-label" for="@($"seat{seat.SeatType}{i}")">@seat.Name (@seat.SeatType.ToString()) - €@seat.Price</label>
                </div>
            }
        }
    </div>

    <!-- SECTION 4: PAYMENT -->
    <div data-section class="d-none">
        <h3>Payment</h3>
        <select name="Payment.CardType" id="cardType" class="form-select mb-3">
            <option hidden disabled selected>Select a card type</option>
            @foreach (object? item in Enum.GetValues(typeof(CardType)))
            {
                <option value="@item">@item.ToString()</option>
            }
        </select>
        <input name="Payment.CardNumber" type="text" class="form-control mb-2" id="cardNumber" placeholder="1234 1234 1234 1234">
        <input name="Payment.ExpiryDate" type="month" class="form-control mb-2" id="cardExpiryDate">
        <input name="Payment.CardHolder" type="text" class="form-control mb-2" id="cardHolder" placeholder="John Doe">
        <input name="Payment.CVC" type="text" class="form-control mb-2" id="cvc" placeholder="123">
    </div>

    <div class="d-flex justify-content-between mt-4">
        <button type="button" class="btn btn-outline-secondary" id="prevBtn">Previous</button>
        <button type="button" class="btn btn-primary" id="nextBtn">Next</button>
    </div>
</form>


<script src="~/js/createBooking.js"></script>