@model CreateBookingDto

<form id="bookingForm" asp-controller="Booking" asp-action="CreateBooking" class="booking-wizard"
      data-passengers="@Model.Passengers.Count"
      data-has-inbound="@(Model.InboundFlights.Count > 0)">

    <!-- TOP: steps + combined summary -->
    <div class="bw-top-grid">
        <div class="bw-main-col">
            <div class="bw-steps" role="tablist" aria-label="Booking steps">
                <button type="button" class="bw-step" data-step="0">1 — Flights</button>
                <button type="button" class="bw-step" data-step="1">2 — Passengers</button>
                <button type="button" class="bw-step" data-step="2">3 — Services & Seats</button>
                <button type="button" class="bw-step" data-step="3">4 — Payment</button>
            </div>

            <!-- SECTION 1: FLIGHT SELECTION -->
            <div data-section class="bw-section">
                <h3>Outbound Flights</h3>

                @for (int i = 0; i < Model.OutboundFlights.Count; i++)
                {
                    var f = Model.OutboundFlights[i];
                    <div class="bw-flight-card">
                        <!-- input inside label so the circle sits inside the card -->
                        <label for="outbound-@f.Id" class="bw-flight-label">
                            <input data-price="@f.PriceInEur" class="form-check-input bw-flight-radio" type="radio" value="@f.Id" name="OutboundId" id="outbound-@f.Id" />
                            <div class="bw-flight-content">
                                <div class="fw-bold bw-route">@f.Origin &rarr; @f.Destination</div>
                                <div class="text-muted small bw-times">@f.DepartureUTC - @f.ArrivalUTC</div>
                            </div>
                            <div class="bw-price">€@f.PriceInEur</div>
                        </label>
                    </div>
                }

                @if (Model.InboundFlights.Count > 0)
                {
                    <h3 class="mt-4">Inbound Flights</h3>
                    @for (int i = 0; i < Model.InboundFlights.Count; i++)
                    {
                        var f = Model.InboundFlights[i];
                        <div class="bw-flight-card">
                            <label for="inbound-@f.Id" class="bw-flight-label">
                                <input data-price="@f.PriceInEur" class="form-check-input bw-flight-radio" type="radio" value="@f.Id" name="InboundId" id="inbound-@f.Id" />
                                <div class="bw-flight-content">
                                    <div class="fw-bold bw-route">@f.Origin &rarr; @f.Destination</div>
                                    <div class="text-muted small bw-times">@f.DepartureUTC - @f.ArrivalUTC</div>
                                </div>
                                <div class="bw-price">€@f.PriceInEur</div>
                            </label>
                        </div>
                    }
                }
            </div>

            <!-- SECTION 2: PASSENGERS -->
            <div data-section class="bw-section bw-hidden">
                <h3>Passengers</h3>

                @for (int i = 0; i < Model.Passengers.Count; i++)
                {
                    <h5>Passenger @(i + 1)</h5>
                    <div class="p-3 border rounded mb-4 passenger-card" data-passenger-index="@i">
                        <div class="row g-2">
                            <div class="col-6">
                                <label for="@($"firstName{i}")" class="form-label">First Name</label>
                                <input name="Passengers[@i].FirstName" type="text" class="form-control" id="@($"firstName{i}")" placeholder="John" />
                            </div>
                            <div class="col-6">
                                <label for="@($"lastName{i}")" class="form-label">Last Name</label>
                                <input name="Passengers[@i].LastName" type="text" class="form-control" id="@($"lastName{i}")" placeholder="Doe" />
                            </div>
                        </div>

                        <div class="row g-2 mt-2">
                            <div class="col-6">
                                <label for="@($"dob{i}")" class="form-label">Date of Birth</label>
                                <input name="Passengers[@i].DateOfBirth" type="date" class="form-control" id="@($"dob{i}")" />
                            </div>

                            <div class="col-6">
                                <label class="form-label d-block">Gender</label>

                                <!-- compact grouped control: label above, controls side-by-side -->
                                <div class="gender-toggle d-inline-flex" role="radiogroup" aria-label="Gender">
                                    <!-- keep the radio inputs (hidden) for form binding & accessibility -->
                                    <input type="radio" id="male-@i" name="Passengers[@i].Gender" value="Male" hidden />
                                    <label for="male-@i" class="gender-btn" tabindex="0" role="radio" aria-checked="false">Male</label>

                                    <input type="radio" id="female-@i" name="Passengers[@i].Gender" value="Female" hidden />
                                    <label for="female-@i" class="gender-btn" tabindex="0" role="radio" aria-checked="false">Female</label>
                                </div>
                            </div>
                        </div>


                        <div class="form-check form-switch mt-3">
                            <input class="form-check-input check-in-toggle" type="checkbox" role="switch" id="@($"checkInNow{i}")" />
                            <label class="form-check-label" for="@($"checkInNow{i}")">Check in now</label>
                        </div>

                        <!-- Travel doc (kept fully, both select lists) -->
                        <div class="travel-doc bw-hidden mt-3 p-3 border rounded">
                            <select name="Passengers[@i].TravelDocument.DocumentType" id="@($"travelDocType{i}")" class="form-select mb-2">
                                <option hidden disabled selected>Select a travel document</option>
                                @foreach (object? item in Enum.GetValues(typeof(DocumentType)))
                                {
                                    <option value="@item">@item.ToString()</option>
                                }
                            </select>

                            <input name="Passengers[@i].TravelDocument.Number" type="text" class="form-control mb-2" id="@($"documentNumber{i}")" placeholder="Document Number" />
                            <input name="Passengers[@i].TravelDocument.IssueDate" type="date" class="form-control mb-2" id="@($"issueDate{i}")" placeholder="Issue Date" />
                            <input name="Passengers[@i].TravelDocument.ExpiryDate" type="date" class="form-control mb-2" id="@($"expiryDate{i}")" placeholder="Expiry Date" />

                            <select name="Passengers[@i].TravelDocument.NationalityId" id="@($"nationality{i}")" class="form-select mb-2">
                                <option hidden disabled selected>Select your nationality</option>
                                @foreach (SelectListItem country in Model.CountriesSelect)
                                {
                                    <option value="@country.Value">@country.Text</option>
                                }
                            </select>

                            <select name="Passengers[@i].TravelDocument.BirthCountryId" id="@($"birthCountry{i}")" class="form-select">
                                <option hidden disabled selected>Select your birth country</option>
                                @foreach (SelectListItem country in Model.CountriesSelect)
                                {
                                    <option value="@country.Value">@country.Text</option>
                                }
                            </select>
                        </div>
                    </div>
                }
            </div>

            <!-- SECTION 3: SERVICES + SEAT MAP -->
            <div data-section class="bw-section bw-hidden">
                <h3>Services & Seat Selection</h3>

                @for (int i = 0; i < Model.Passengers.Count; i++)
                {
                    <h5>Passenger @(i + 1)</h5>

                    <div class="service-list mb-3">
                        @foreach (ServiceDto service in Model.Services)
                        {
                            <label class="service-pill">
                                <input data-price="@service.Price" type="checkbox" name="Passengers[@i].ServiceIds" value="@service.Id" />
                                <span class="service-name">@service.Name</span>
                                <span class="service-price">€@service.Price</span>
                            </label>
                        }
                    </div>

                    <div class="mb-3">
                        <h6>Select Baggage</h6>
                        @foreach (ServiceDto bag in Model.BaggageService)
                        {
                            <label class="baggage-item form-check">
                                <input data-price="@bag.Price" type="radio" name="Passengers[@i].Baggage" value="@bag.Id" class="form-check-input" />
                                <span class="baggage-text">@bag.Name (@bag.Kilos kg) - €@bag.Price</span>
                            </label>
                        }
                    </div>

                    <div class="seat-map-container mb-4">
                        <h6>Select Seat (Outbound)</h6>
                        <div id="seatMapOutbound-@i" class="seat-map" data-passenger-index="@i" data-direction="outbound" aria-label="Outbound seat map for passenger @i"></div>
                        <input type="hidden" name="Passengers[@i].SeatSelectionOutbound" id="seatSelectionOutbound-@i" />

                        @if (Model.InboundFlights.Count > 0)
                        {
                            <h6 class="mt-3">Select Seat (Inbound)</h6>
                            <div id="seatMapInbound-@i" class="seat-map" data-passenger-index="@i" data-direction="inbound" aria-label="Inbound seat map for passenger @i"></div>
                            <input type="hidden" name="Passengers[@i].SeatSelectionInbound" id="seatSelectionInbound-@i" />
                        }
                    </div>

                    <div class="mb-3 seat-type-row">
                        <label class="fw-bold">Seat Type</label>

                        <label class="seat-type-item">
                            <input id="@($"noSeat{i}")" class="seat-type" type="radio" name="Passengers[@i].Seats"
                                   value="@Model.SeatsServices.First(s => s.SeatType == SeatType.None).Id"
                                   data-seat-type="None"
                                   data-price="@Model.SeatsServices.First(s => s.SeatType == SeatType.None).Price"
                                   checked />
                            <span>Random (Free)</span>
                        </label>

                        <label class="seat-type-item">
                            <input id="@($"normalSeat{i}")" class="seat-type" type="radio" name="Passengers[@i].Seats"
                                   value="@Model.SeatsServices.First(s => s.SeatType == SeatType.Normal).Id"
                                   data-seat-type="Normal"
                                   data-price="@Model.SeatsServices.First(s => s.SeatType == SeatType.Normal).Price" />
                            <span>Normal (€@Model.SeatsServices.First(s => s.SeatType == SeatType.Normal).Price)</span>
                        </label>

                        <label class="seat-type-item">
                            <input id="@($"extraLegRoomSeat{i}")" class="seat-type" type="radio" name="Passengers[@i].Seats"
                                   value="@Model.SeatsServices.First(s => s.SeatType == SeatType.ExtraLegRoom).Id"
                                   data-seat-type="ExtraLegRoom"
                                   data-price="@Model.SeatsServices.First(s => s.SeatType == SeatType.ExtraLegRoom).Price" />
                            <span>Extra Leg Room (€@Model.SeatsServices.First(s => s.SeatType == SeatType.ExtraLegRoom).Price)</span>
                        </label>
                    </div>
                }
            </div>

            <!-- SECTION 4: PAYMENT -->
            <div data-section class="bw-section bw-hidden">
                <h3>Payment</h3>

                <div class="alert alert-info mt-3 fw-bold">
                    Total Price: <span id="totalPrice">€0.00</span>
                </div>

                <input type="hidden" id="totalPriceInput" name="Payment.AmountInEur" value="0.00" />

                <label class="form-label">Card Type</label>
                <select name="Payment.CardType" id="cardType" class="form-select mb-2">
                    <option hidden disabled selected>Select a card type</option>
                    @foreach (object? item in Enum.GetValues(typeof(CardType)))
                    {
                        <option value="@item">@item.ToString()</option>
                    }
                </select>

                <label class="form-label">Card Number</label>
                <input name="Payment.CardNumber" type="text" class="form-control mb-2" id="cardNumber" placeholder="1234 1234 1234 1234" />

                <div class="d-flex gap-2">
                    <div style="flex:1">
                        <label class="form-label">Expiry</label>
                        <input name="Payment.ExpiryDate" type="month" class="form-control mb-2" id="cardExpiryDate" />
                    </div>
                    <div style="width:120px">
                        <label class="form-label">CVC</label>
                        <input name="Payment.CVC" type="text" class="form-control mb-2" id="cvc" placeholder="123" />
                    </div>
                </div>

                <label class="form-label">Card Holder</label>
                <input name="Payment.CardHolder" type="text" class="form-control mb-2" id="cardHolder" placeholder="John Doe" />
            </div>

            <div class="d-flex justify-content-between mt-4 wizard-nav">
                <button type="button" class="btn btn-outline-secondary" id="prevBtn">Previous</button>
                <button type="button" class="btn btn-primary" id="nextBtn">Next</button>
            </div>
        </div>

        <!-- RIGHT: detailed summary panel -->
        <aside class="bw-summary-col" aria-live="polite">
            <div class="summary-header">
                <div class="summary-title">Order summary</div>
                <div class="summary-sub">Quick review before payment</div>
            </div>

            <div class="summary-content" id="detailedSummary">
                <!-- Populated by JS: shows selected flights + passenger details (seat, services, baggage, checked-in, travel doc present) -->
                <div class="summary-block">
                    <div><strong>Outbound:</strong> <span id="summaryOutboundShort">—</span></div>
                    <div><strong>Inbound:</strong> <span id="summaryInboundShort">—</span></div>
                    <div><strong>Passengers:</strong> <span id="summaryPassengersShort">@Model.Passengers.Count</span></div>
                    <div class="summary-total">Total: <strong id="summaryTotalShort">€0.00</strong></div>
                </div>

                <div id="passengersSummaryList" class="passengers-summary-list">
                    <!-- JS will inject detailed per-passenger cards here -->
                </div>
            </div>
        </aside>
    </div>
</form>

<script src="~/js/createBooking.js"></script>